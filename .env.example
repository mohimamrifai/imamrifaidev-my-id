# ---------------------------------------------------------------------------
# Local development: the Neon CLI writes the storage/Postgres variables for you
# with `neon deploy` (or `neon env pull`). Copy the rest of this file's
# app-specific variables manually. On Vercel, add every variable below in
# Settings -> Environment Variables.
# ---------------------------------------------------------------------------

# --- Neon Postgres ---------------------------------------------------------
# Pooled connection string (used by the app). `neon deploy` fills this in.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
# Direct (non-pooled) connection string, used for migrations.
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# --- Neon Object Storage (S3-compatible, injected by `neon deploy`) --------
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_ENDPOINT_URL_S3=""
AWS_REGION=""

# --- Dashboard auth --------------------------------------------------------
# Credentials for /login. Defaults live in `src/lib/session.ts` and are used
# when these are not set.
ADMIN_EMAIL="imamrifaibisnis@gmail.com"
ADMIN_PASSWORD="Webkumaspalul123@"

# Secret used to sign the session cookie. Generate one with:
#   openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string"
